# Lightweight HTTP-only MCP. No model downloads or local OCR runtimes.
OVISOCR3_BASE_URL=http://127.0.0.1:8731/v1
OVISOCR3_MODEL=OvisOCR3
OVISOCR3_API_KEY=
OVISOCR3_TIMEOUT=180
OVISOCR3_PROMPT="Convert this page to Markdown."
MCP_HOST=127.0.0.1
MCP_PORT=10859
# Required confinement: blank/unset defaults to ./documents; Docker sets /documents.
OCR_DOCUMENT_ROOT=./documents
OCR_MAX_FILE_BYTES=52428800
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MAX_PDF_PAGES=100
OCR_MAX_OUTPUT_CHARS=1000000

# Optional model-card capabilities. Default stays at two tools.
OCR_MCP_PROFILE=basic
# Comma-separated explicit tool allowlist; overrides the profile when nonempty.
# OCR_MCP_TOOLS=process_document,get_status,reconstruct_table
OCR_MCP_TOOLS=
OVISOCR3_MAX_TOKENS=16384
OCR_MAX_PROMPT_CHARS=200000

# Optional document-level recursive tables (uv sync --extra crosspage).
# OCR_MCP_PROFILE=crosspage
OCR_CROSSPAGE_MAX_PAGES=20
# Default artifact root: OS temp directory / ocr-mcp-tables. Run cleanup from a timer.
# OCR_ARTIFACT_DIR=/var/lib/ocr-mcp/artifacts
# OCR_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Independent cleanup command policies. 0 disables the respective policy.
OCR_ARTIFACT_RETENTION_DAYS=7
OCR_ARTIFACT_MAX_GB=5
